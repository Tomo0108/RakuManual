# API
PORT=3001
HOST=127.0.0.1

# LLM（未設定時は構造化モック。設定すると OpenAI 実API）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 社内 IdP（すべて設定すると /api/auth/oidc/* が外部OIDCへ切替）
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://127.0.0.1:5173/?sso=callback
# 任意上書き:
# OIDC_AUTHORIZE_URL=
# OIDC_TOKEN_URL=
# OIDC_USERINFO_URL=
# OIDC_SCOPE=openid profile email
