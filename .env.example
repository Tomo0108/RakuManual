# API
PORT=3001
HOST=127.0.0.1

# フロント（Vercel）から API を見る場合はビルド時に設定
# VITE_API_BASE_URL=https://your-api.example.com/api

# API の CORS（カンマ区切り）。*.vercel.app はコード側で許可
# ALLOWED_ORIGINS=https://your-app.vercel.app
# クロスサイト Cookie（Vercel ↔ 別ホスト API）
# COOKIE_SAMESITE=none
# COOKIE_SECURE=true

# ========== LLM ==========
# プロバイダ: mock | openrouter | gateway | openai
# 未指定時はキー有無から自動判定（openrouter > gateway > openai > mock）
LLM_PROVIDER=

# --- 試運転: OpenRouter（モデルを差し替えて検証）---
# 例: openai/gpt-4o-mini, anthropic/claude-sonnet-4, google/gemini-2.5-flash
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
# OPENROUTER_HTTP_REFERER=https://your-app.example
# OPENROUTER_APP_TITLE=RakuManual

# --- 本番想定: 社内 Gateway（OpenAI 互換 /v1/chat/completions）---
# LLM_PROVIDER=gateway
# LLM_GATEWAY_BASE_URL=https://gateway.example.com/v1
# LLM_GATEWAY_API_KEY=
# LLM_MODEL=gpt-4o-mini
# 追加ヘッダが必要なら JSON: {"X-Tenant":"xxx"}
# LLM_GATEWAY_HEADERS=

# --- 互換: OpenAI 直結（通常は不要）---
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# 社内 IdP（すべて設定すると /api/auth/oidc/* が外部OIDCへ切替）
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://127.0.0.1:5173/?sso=callback
# 任意上書き:
# OIDC_AUTHORIZE_URL=
# OIDC_TOKEN_URL=
# OIDC_USERINFO_URL=
# OIDC_SCOPE=openid profile email
